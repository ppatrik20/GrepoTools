generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model World {
  id              String    @id // e.g. "hu119", "en143"
  name            String
  server          String    // e.g. "hu119"
  speed           Float     @default(1.0)
  unitSpeed       Float     @default(1.0)
  worldType       String    @default("siege") // "siege" or "revolt"
  isActive        Boolean   @default(true)
  lastSync        DateTime?
  geoJsonCache    String?   @db.Text
  scoreboardCache String?   @db.Text
  createdAt       DateTime  @default(now())

  players         Player[]
  alliances       Alliance[]
  towns           Town[]
  islands         Island[]
  conquests       Conquest[]
  playerHistories PlayerHistory[]
  allianceHistories AllianceHistory[]
  townHistories   TownHistory[]
  snipeOperations SnipeOperation[]
  reports         Report[]
  coalitions      Coalition[]
  teams           Team[]
  teamMemberships TeamMember[]
  invites         Invite[]

  @@index([isActive])
}

model Unit {
  id               String   @id
  name             String
  name_plural      String
  speed            Int
  attack           Int
  description      String
  resources_wood   Int?
  resources_stone  Int?
  resources_iron   Int?
  favor            Int
  population       Int
  build_time       Int
  god_id           String?
  is_naval         Boolean
  unit_function    String
  category         String
  is_npc_unit_only Boolean
  def_hack         Int
  def_pierce       Int
  def_distance     Int
  booty            Int?
  infantry         Boolean?
  flying           Boolean?
  attack_type      String?
  capacity         Int?
}

model Report {
  id           String   @id @default(uuid())
  worldId      String   @default("hu119")
  originalId   String? // The GRCT report ID if applicable
  attacker     String
  attackerTown String?
  defender     String
  defenderTown String?
  date         DateTime
  morale       Int?
  luck         Int?
  lootedWood   Int      @default(0)
  lootedStone  Int      @default(0)
  lootedIron   Int      @default(0)
  rawText      String?  @db.Text
  createdAt    DateTime @default(now())

  world        World?   @relation(fields: [worldId], references: [id], onDelete: Cascade)

  @@index([worldId])
  @@index([attackerTown])
  @@index([defenderTown])
  @@index([date])
}

model Island {
  id             Int
  worldId        String @default("hu119")
  x              Int
  y              Int
  type           Int
  availableTowns Int
  resourcePlus   String
  resourceMinus  String

  world          World? @relation(fields: [worldId], references: [id], onDelete: Cascade)

  @@id([id, worldId])
  @@index([worldId, x, y])
}

model Alliance {
  id      Int
  worldId String   @default("hu119")
  name    String
  points  Int
  towns   Int
  members Int
  rank    Int
  abp     Int      @default(0)
  dbp     Int      @default(0)
  allBp   Int      @default(0)
  players Player[]
  world   World?   @relation(fields: [worldId], references: [id], onDelete: Cascade)

  @@id([id, worldId])
  @@index([worldId, name])
  @@index([worldId, points])
  @@index([name])
}

model Player {
  id         Int
  worldId    String    @default("hu119")
  name       String
  allianceId Int?
  points     Int
  rank       Int
  towns      Int
  abp        Int       @default(0)
  dbp        Int       @default(0)
  allBp      Int       @default(0)
  townsList  Town[]
  alliance   Alliance? @relation(fields: [allianceId, worldId], references: [id, worldId], onDelete: SetNull)
  world      World?    @relation(fields: [worldId], references: [id], onDelete: Cascade)

  @@id([id, worldId])
  @@index([worldId, name])
  @@index([worldId, points])
  @@index([name])
}

model PlayerHistory {
  id         Int      @id @default(autoincrement())
  worldId    String   @default("hu119")
  playerId   Int
  oldPoints  Int
  newPoints  Int
  abpDelta   Int      @default(0)
  dbpDelta   Int      @default(0)
  allBpDelta Int      @default(0)
  timestamp  DateTime @default(now())

  world      World?   @relation(fields: [worldId], references: [id], onDelete: Cascade)

  @@index([worldId, playerId, timestamp])
  @@index([playerId, timestamp])
}

model AllianceHistory {
  id         Int      @id @default(autoincrement())
  worldId    String   @default("hu119")
  allianceId Int
  oldPoints  Int
  newPoints  Int
  abpDelta   Int      @default(0)
  dbpDelta   Int      @default(0)
  allBpDelta Int      @default(0)
  timestamp  DateTime @default(now())

  world      World?   @relation(fields: [worldId], references: [id], onDelete: Cascade)

  @@index([worldId, allianceId, timestamp])
  @@index([allianceId, timestamp])
}

model Town {
  id         Int
  worldId    String  @default("hu119")
  playerId   Int?
  name       String
  islandX    Int
  islandY    Int
  islandSlot Int
  points     Int
  player     Player? @relation(fields: [playerId, worldId], references: [id, worldId], onDelete: SetNull)
  world      World?  @relation(fields: [worldId], references: [id], onDelete: Cascade)

  // Custom command center fields
  specialization        String  @default("NONE")
  bunksResearched       Boolean @default(false)
  plowResearched        Boolean @default(false)
  cartographyResearched Boolean @default(false)
  mathResearched        Boolean @default(false)
  hasThermalBaths       Boolean @default(false)
  hasTower              Boolean @default(false)
  hasLighthouse         Boolean @default(false)

  // Building levels (null represents untracked)
  mainLevel             Int?
  farmLevel             Int?
  barracksLevel         Int?
  docksLevel            Int?
  wallLevel             Int?
  templeLevel           Int?
  lumberLevel           Int?
  stonerLevel           Int?
  ironerLevel           Int?
  marketLevel           Int?
  academyLevel          Int?

  // Relations
  snipeOperations       SnipeOperation[] @relation("TargetTown")
  snipeOrigins          SnipeOperation[] @relation("OriginTown")

  @@id([id, worldId])
  @@index([worldId, islandX, islandY])
  @@index([worldId, playerId])
  @@index([islandX, islandY])
}

model SnipeOperation {
  id                String    @id @default(uuid())
  worldId           String    @default("hu119")
  userId            String?
  label             String
  type              String    @default("recall")
  worldType         String    @default("siege")
  targetTownId      Int
  originTownId      Int
  targetReturnTime  DateTime
  sendTime          DateTime
  recallTime        DateTime?
  status            String    @default("PENDING")
  notes             String?
  createdAt         DateTime  @default(now())

  targetTown        Town      @relation("TargetTown", fields: [targetTownId, worldId], references: [id, worldId], onDelete: Cascade)
  originTown        Town      @relation("OriginTown", fields: [originTownId, worldId], references: [id, worldId], onDelete: Cascade)
  world             World?    @relation(fields: [worldId], references: [id], onDelete: Cascade)
  user              User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([worldId, sendTime])
  @@index([sendTime])
  @@index([status])
  @@index([userId])
}

model TownHistory {
  id        Int      @id @default(autoincrement())
  worldId   String   @default("hu119")
  townId    Int
  oldPoints Int
  newPoints Int
  timestamp DateTime @default(now())

  world     World?   @relation(fields: [worldId], references: [id], onDelete: Cascade)

  @@index([worldId, townId, timestamp])
  @@index([townId, timestamp])
}

model Conquest {
  id            Int      @id @default(autoincrement())
  worldId       String   @default("hu119")
  townId        Int
  townPoints    Int
  oldPlayerId   Int?
  newPlayerId   Int?
  oldAllianceId Int?
  newAllianceId Int?
  timestamp     DateTime

  world         World?   @relation(fields: [worldId], references: [id], onDelete: Cascade)

  @@index([worldId, timestamp])
  @@index([townId])
}

model SyncMetadata {
  id              Int      @id @default(1)
  worldId         String   @default("hu119")
  lastSync        DateTime @default(now())
  geoJsonCache    String?  @db.Text
  scoreboardCache String?  @db.Text
}

model Building {
  id                String @id
  name              String
  description       String
  max_level         Int
  min_level         Int
  base_wood         Float
  base_stone        Float
  base_iron         Float
  base_pop          Float
  base_build_time   Float
  base_points       Float
  wood_factor       Float
  stone_factor      Float
  iron_factor       Float
  pop_factor        Float
  build_time_factor Float
  points_factor     Float

  dependenciesAsRequirement BuildingDependency[] @relation("RequiredBuilding")
  dependencies              BuildingDependency[] @relation("DependentBuilding")
}

model BuildingDependency {
  buildingId         String
  requiredBuildingId String
  requiredLevel      Int

  building         Building @relation("DependentBuilding", fields: [buildingId], references: [id])
  requiredBuilding Building @relation("RequiredBuilding", fields: [requiredBuildingId], references: [id])

  @@id([buildingId, requiredBuildingId])
}

model Hero {
  id           String @id
  name         String
  category     String
  cost         Int
  attack       Int
  def_hack     Int
  def_pierce   Int
  def_distance Int
  speed        Int
  booty        Int
  attack_type  String
  modifiers    Json
}

model GodPower {
  id            String  @id
  name          String
  god_id        String?
  favor         Int
  lifetime      Int
  targets       Json
  meta_defaults Json?
}

model Coalition {
  id          String   @id @default(uuid())
  worldId     String   @default("hu119")
  name        String
  color       String   @default("#10b981")
  allianceIds Int[]
  alliances   String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  world       World?   @relation(fields: [worldId], references: [id], onDelete: Cascade)

  @@unique([worldId, name])
  @@index([worldId])
}

model User {
  id                  String         @id @default(uuid())
  username            String         @unique // Grepolis in-game username (case-preserved, normalized for lookup)
  passwordHash        String
  globalRole          String         @default("USER") // "GLOBAL_ADMIN" | "USER"
  isActive            Boolean        @default(true)
  failedLoginAttempts Int            @default(0)
  lockoutUntil        DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  teamMemberships     TeamMember[]
  refreshTokens       RefreshToken[]
  createdInvites      Invite[]
  auditLogs           AuditLog[]
  snipeOperations     SnipeOperation[]

  @@index([username])
}

model Team {
  id          String       @id @default(uuid())
  name        String       // e.g. "Aegis Vanguard"
  worldId     String
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  world       World        @relation(fields: [worldId], references: [id], onDelete: Cascade)
  members     TeamMember[]
  invites     Invite[]
  customRoles TeamCustomRole[]

  @@unique([worldId, name])
  @@index([worldId])
}

model TeamMember {
  id                 String    @id @default(uuid())
  teamId             String
  userId             String
  worldId            String
  role               String    @default("TEAM_MEMBER") // "TEAM_ADMIN" | "TEAM_MEMBER"
  playerId           Int       // Grepolis Player ID
  playerName         String    // Grepolis Player Name
  verificationCode   String    // e.g. "GP-742918"
  verificationStatus String    @default("UNVERIFIED") // "UNVERIFIED" | "VERIFIED"
  verifiedAt         DateTime?
  createdAt          DateTime  @default(now())

  team               Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  world              World     @relation(fields: [worldId], references: [id], onDelete: Cascade)
  customRoles        TeamMemberRoleAssignment[]

  @@unique([teamId, userId])
  @@unique([worldId, playerId]) // One user claim per in-game player per world
  @@index([worldId, verificationStatus])
  @@index([teamId, role])
}

model TeamCustomRole {
  id          String   @id @default(uuid())
  teamId      String
  name        String
  description String?
  color       String?  @default("#3B82F6")
  icon        String?  @default("shield")
  permissions String[]
  priority    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  team        Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  assignments TeamMemberRoleAssignment[]

  @@unique([teamId, name])
  @@index([teamId])
}

model TeamMemberRoleAssignment {
  id           String         @id @default(uuid())
  memberId     String
  customRoleId String
  assignedAt   DateTime       @default(now())

  member       TeamMember     @relation(fields: [memberId], references: [id], onDelete: Cascade)
  customRole   TeamCustomRole @relation(fields: [customRoleId], references: [id], onDelete: Cascade)

  @@unique([memberId, customRoleId])
  @@index([memberId])
  @@index([customRoleId])
}

model Invite {
  id               String    @id @default(uuid())
  token            String    @unique
  teamId           String
  worldId          String
  role             String    @default("TEAM_MEMBER") // "TEAM_ADMIN" | "TEAM_MEMBER"
  targetPlayerName String    // The specific Grepolis player invited
  createdById      String
  customRoleIds    String[]  @default([])
  maxUses          Int       @default(1)
  usedCount        Int       @default(0)
  expiresAt        DateTime
  createdAt        DateTime  @default(now())

  team             Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  world            World     @relation(fields: [worldId], references: [id], onDelete: Cascade)
  createdBy        User      @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([teamId])
  @@index([worldId])
}

model RefreshToken {
  id          String   @id @default(uuid())
  userId      String
  tokenHash   String   @unique
  familyId    String   // Tracks rotation lineage for replay attack containment
  isRevoked   Boolean  @default(false)
  userAgent   String?
  ipAddress   String?
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([tokenHash])
}

model AuditLog {
  id             String   @id @default(uuid())
  userId         String?
  actorUsername  String?  // Grepolis username of actor
  action         String   // e.g. "AUTH_LOGIN_SUCCESS", "TOWN_VERIFIED", "TEAM_CREATED", etc.
  targetResource String?  // e.g. "team:uuid", "world:hu119", "user:Leonidas"
  ipAddress      String?
  userAgent      String?
  status         String   // "SUCCESS" | "WARNING" | "FAILURE"
  details        Json?
  createdAt      DateTime @default(now())

  user           User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@index([createdAt])
}


